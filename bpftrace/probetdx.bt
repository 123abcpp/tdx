kprobe:__xfd_enable_feature {
	printf("Entry __xfd_enable_feauture\n");
	$s = (struct fpu_guest *)arg1;
	$f = $s->xfeatures;
	$p = $s->perm; 
	printf("Arg: xfd_er:%x, xfeature:%x, perm:%x\n", arg0, $f, $p);
}

kretprobe:__xfd_enable_feature {
	printf("Exit xfd_enable_feature - ret:%d", retval);
}
